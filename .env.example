# Copy this file to .env, chmod 600 .env, then replace both required secrets.
# Or run: uv run python scripts/bootstrap.py (creates local-only configuration).
A4G_ADMIN_PASSWORD=
A4G_SESSION_SECRET=
A4G_DATA_DIR=./data
# Production requires HTTPS. Set false only for local loopback development.
A4G_SECURE_COOKIES=true
A4G_PUBLIC_ORIGIN=https://operator.your-domain.com
A4G_ALLOWED_HOSTS=["operator.your-domain.com","localhost","127.0.0.1"]

# Your own provider key. No bundled credits or inherited Tin credentials.
A4G_OPENAI_API_KEY=
A4G_MODEL=gpt-5.4-mini
A4G_MAX_OUTPUT_TOKENS=4096
A4G_MAX_STEPS=12
A4G_MAX_DAILY_RUNS=30
A4G_WORKER_POLL_SECONDS=2

# Optional. Fine-grained token scoped to ONE repository.
# Contents: read/write, Issues: read/write, Pull requests: read/write; no workflow permission.
A4G_GITHUB_TOKEN=
A4G_GITHUB_REPO=iamaanahmad/Agent4Good
# Optional Brave Search API key.
A4G_SEARCH_API_KEY=
# Exact public HTTPS hosts only, no wildcards. Redirects are refused.
A4G_ALLOWED_READ_HOSTS=[]
# Optional Resend key and a sender on a verified domain.
A4G_RESEND_API_KEY=
A4G_MAIL_FROM=

# One database per tenant and environment. Multi-user mode is unavailable.
A4G_TENANT_ID=default
A4G_ENVIRONMENT=local
A4G_ISOLATION_MODE=single_owner
# Optional vault: external private key file, never under A4G_DATA_DIR.
# A4G_CREDENTIAL_KEY_FILE=/secure/agent4good/keyring.json

# Optional second provider. Keys stay server-side or in the encrypted vault.
A4G_ANTHROPIC_API_KEY=
# Named profiles and six work routes are JSON objects. See docs/model-routing.md.
A4G_MODEL_PROFILES={}
A4G_MODEL_ROUTES={}
A4G_MAX_TASK_MODEL_RESERVED_TOKENS=2000000
# Optional estimated cost cap; requires both per-million prices on each profile.
# A4G_MAX_TASK_MODEL_COST_USD=1

# Optional private sandbox broker; see docs/isolated-coding.md.
# A4G_SANDBOX_SOCKET=/run/agent4good-sandbox/broker.sock
A4G_SANDBOX_SOURCE_PREFIX=
# Delivery stays disabled until exact checks and workflows are configured.
A4G_GITHUB_MERGE_CHECKS=[]
A4G_GITHUB_DEPLOY_WORKFLOWS=[]
# Optional repository-scoped GitHub App installation credentials, server-side only.
# A4G_GITHUB_APP_ID=
# A4G_GITHUB_INSTALLATION_ID=
# A4G_GITHUB_APP_PRIVATE_KEY=

# Optional private browser broker; see docs/browser-control.md
A4G_BROWSER_SOCKET=

# Retrieved memory budget, conservatively measured in UTF-8 bytes. 0 disables automatic retrieval.
A4G_MEMORY_CONTEXT_BUDGET=4096

# Optional owner-defined mandatory quality contracts by work type; see docs/independent-quality.md.
A4G_QUALITY_DEFAULTS={}

# Cloud credentials belong in the vault. Legacy environment-only deployments may use these JSON values.
# Never commit credentials. See docs/cloud-models-and-skills.md.
A4G_BEDROCK_CREDENTIALS=
A4G_VERTEX_CREDENTIALS=
A4G_DATAFORSEO_CREDENTIALS=

# Optional instance branding. Restart web after changes; no database migration.
A4G_BRAND_NAME=agentforge
A4G_BRAND_TAGLINE="A place for work to move forward."
# Dark hexadecimal color, at least 4.5:1 contrast against white.
A4G_BRAND_ACCENT=#185b46
# Optional local PNG/JPEG/WebP (at most 256 KiB). Never point at a private file.
# A4G_BRAND_LOGO_FILE=/absolute/path/to/logo.png
