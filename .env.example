# Copy this file to .env, chmod 600 .env, then replace both required secrets.
# Or run: uv run python scripts/bootstrap.py (creates local-only configuration).
A4G_ADMIN_PASSWORD=
A4G_SESSION_SECRET=
A4G_DATA_DIR=./data
# Production requires HTTPS. Set false only for local loopback development.
A4G_SECURE_COOKIES=true
A4G_PUBLIC_ORIGIN=https://operator.your-domain.com
A4G_ALLOWED_HOSTS=["operator.your-domain.com","localhost","127.0.0.1"]

# Your own provider key. No bundled credits or inherited Tin credentials.
A4G_OPENAI_API_KEY=
A4G_MODEL=gpt-5.4-mini
A4G_MAX_OUTPUT_TOKENS=4096
A4G_MAX_STEPS=12
A4G_MAX_DAILY_RUNS=30
A4G_WORKER_POLL_SECONDS=2

# Optional. Fine-grained token scoped to ONE repository.
# Contents: read/write, Issues: read/write, Pull requests: read/write; no workflow permission.
A4G_GITHUB_TOKEN=
A4G_GITHUB_REPO=iamaanahmad/Agent4Good
# Optional Brave Search API key.
A4G_SEARCH_API_KEY=
# Exact public HTTPS hosts only, no wildcards. Redirects are refused.
A4G_ALLOWED_READ_HOSTS=[]
# Optional Resend key and a sender on a verified domain.
A4G_RESEND_API_KEY=
A4G_MAIL_FROM=

# One database per tenant and environment. Multi-user mode is unavailable.
A4G_TENANT_ID=default
A4G_ENVIRONMENT=local
A4G_ISOLATION_MODE=single_owner
# Optional vault: external private key file, never under A4G_DATA_DIR.
# A4G_CREDENTIAL_KEY_FILE=/secure/agent4good/keyring.json
